# The start script creates a random local session key if this value is blank.
PETAL_SESSION_SECRET=

# Set to true only when serving Petal over HTTPS.
PETAL_COOKIE_SECURE=false

# Optional local port overrides for Docker Compose.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# SQLite path inside the backend container; stored in a named Docker volume.
PETAL_DATABASE_PATH=/data/petal.db
